# IDE
.idea/
*.iml

# Main binary (go build)
/klainmain

# make examples' local httpbin-lite fixture server binary
/.httpbin-lite

# Compiled example artifacts — keep only source (.ts), klain.json package
# manifests (needed by the klmpm-package examples, TDD-00054), and
# subdirectories at any depth (klmpm examples nest a package one level
# deeper than every other example: examples/imports/klain_modules/<pkg>/)
examples/**
!examples/**/
!examples/**/*.ts
!examples/**/klain.json

# Build artifacts left behind by compiling docker/*.ts directly on the host
# (e.g. while iterating on a Dockerfile) — the Dockerfiles themselves always
# compile inside the container, these are only ever stray local leftovers.
docker/*.ll
docker/*.gcshim.c

# Fetched Test262 corpus (TDD-00008 Design V2, tools/conformance/fetch.sh) —
# ~263MB, pinned by commit SHA in fetch.sh itself, not vendored into git.
/.test262/

# Generated conformance-run artifacts (tools/conformance) — the committed
# deliverable is docs/testing/CONFORMANCE-RESULTS.md, not these raw logs.
/.conformance-out/
