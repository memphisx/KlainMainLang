# IDE
.idea/
*.iml

# Main binary (go build)
/klainmain

# Conformance runner binary (built by `make conformance*` from tools/conformance)
/conformance

# make examples' local httpbin-lite fixture server binary
/.httpbin-lite
# The httpbin-lite fixture is now compiled from tools/httpbin-lite/httpbin.ts
# by this project's own compiler; that leaves the usual sidecar artifacts +
# the local binary next to the source. Keep the source, ignore the rest.
/tools/httpbin-lite/httpbin
/tools/httpbin-lite/httpbin.*
!/tools/httpbin-lite/httpbin.ts

# Compiled example artifacts — keep only source (.ts), klain.json package
# manifests (needed by the klmpm-package examples, TDD-00054), and
# subdirectories at any depth (klmpm examples nest a package one level
# deeper than every other example: examples/imports/klain_modules/<pkg>/)
examples/**
!examples/**/
!examples/**/*.ts
# JS-mode examples are .js sources by nature (-compat=js, TDD-00022)
!examples/jsmode/*.js
!examples/**/klain.json
# The webview SPA examples ship a dist/ of static assets (a hand-written page,
# or the file-explorer's app + vendored Quasar/Vue UMD) — source for those
# examples, not compiler output (TDD-00142).
!examples/webview/dist/**
!examples/webview/file-explorer/dist/**

# Emitted compiler sidecar artifacts — the .ll IR and the embedded-C helpers
# (dtoa/JSON-tree/bigint/GC-shim) the compiler writes next to any output. These
# are always regenerated and never committed; compiling a .ts anywhere in the
# repo (root, docker/, a scratch test, …) leaves them. The real embedded-C
# *sources* are codegen/llvm/*src/{dtoa,gcshim,json_parse,bigint_tommath}.c —
# none of the form `X.<suffix>.c`, so these globs never match them.
*.ll
*.dtoa.c
*.jsontree.c
*.bigint.c
*.gcshim.c
# Embedded-asset sidecars from `embedDir`/`Webview({ serve })` (TDD-00142 Stage 7):
# the packed blob + its .incbin stub, written next to the output and regenerated.
*.kml_embed_*.bin
*.kml_embed_*.s

# Packaged desktop-app artifacts from `klainmain -package` (TDD-00142 Stage 4):
# a macOS .app bundle / Linux .desktop launcher wrapped around a built binary.
# Regenerated on demand, never committed.
*.app/
*.desktop

# Fetched Test262 corpus (TDD-00008 Design V2, tools/conformance/fetch.sh) —
# ~263MB, pinned by commit SHA in fetch.sh itself, not vendored into git.
/.test262/

# Fetched Node.js + TypeScript conformance corpora (TDD-00121, fetch.sh) —
# pinned by release tag in fetch.sh, sparse/blobless, not vendored into git.
/.node-tests/
/.ts-tests/

# Generated conformance-run artifacts (tools/conformance) — the committed
# deliverables are the reports under docs/testing/, not these raw logs or the
# compiled runner binary. The binary is ignored by its exact path so it does
# not also swallow new source files under tools/conformance/.
/.conformance-out/
/tools/conformance/conformance
